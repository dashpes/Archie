# Research configuration. Copy to config/research.yaml and edit.

# Weights for the composite score. Each is between 0 and 1 and they sum to 1.0.
# A factor with no data is left out and the remaining weights are renormalised.
scoring_weights:
  value: 0.2       # P/E, P/B, P/S, PEG
  growth: 0.2      # revenue and EPS growth, 1y and 3y
  quality: 0.2     # ROE, margin, debt/equity, current ratio, FCF yield
  momentum: 0.2    # 3m/6m/1y change and distance from the 52-week high
  sentiment: 0.2   # distinct insider buyers minus sellers, labeled-news ratio

# Which stocks are scored. Filters apply after the fundamentals snapshot is read.
universe:
  include_sp500: true
  include_nasdaq100: true
  min_market_cap: 1000000000   # $1B
  excluded_sectors: []         # GICS names, e.g. ["Energy", "Utilities"]
  excluded_tickers: []

# Floor for the `top` listing.
thresholds:
  min_composite_score: 60.0

# Fundamentals refresh: a snapshot older than this is refetched, at most this
# many fetches per run (about 600 names turn over in a week at 150/day).
fundamentals_max_age_days: 7
fundamentals_per_run: 150
